  "questions": [
    {
      "id": "der-01",
      "question": "Find the derivative of $f(x) = x^5 + 3x^3 - 2x + 7$.",
      "options": {
        "A": "$5x^4 + 9x^2 - 2$",
        "B": "$5x^4 + 3x^2 - 2$",
        "C": "$x^4 + x^2 - 1$",
        "D": "$5x^5 + 9x^3 - 2x$"
      },
      "correct_answer": "A",
      "explanation": "Apply the power rule: $\\frac{d}{dx}[x^n] = nx^{n-1}$.\n\n$$f'(x) = 5x^{5-1} + 3 \\cdot 3x^{3-1} - 2 \\cdot 1 + 0$$\n$$= 5x^4 + 9x^2 - 2$$",
      "difficulty": "easy",
      "marks": 1,
      "negative_marks": -0.33,
      "tags": ["calculus", "derivatives", "power-rule"]
    },
    {
      "id": "der-02",
      "question": "Find $f'(0)$ for $f(x) = e^x \\cos(x)$.",
      "options": {
        "A": "$1$",
        "B": "$-1$",
        "C": "$0$",
        "D": "$e$"
      },
      "correct_answer": "A",
      "explanation": "Use the product rule: $(uv)' = u'v + uv'$.\n\nLet $u = e^x$ and $v = \\cos(x)$.\n- $u' = e^x$\n- $v' = -\\sin(x)$\n\n$$f'(x) = e^x \\cos(x) + e^x(-\\sin(x)) = e^x(\\cos(x) - \\sin(x))$$\n\nAt $x = 0$:\n$$f'(0) = e^0(\\cos(0) - \\sin(0)) = 1 \\cdot (1 - 0) = 1$$",
      "difficulty": "easy",
      "marks": 1,
      "negative_marks": -0.33,
      "tags": ["calculus", "derivatives", "product-rule"]
    },
    {
      "id": "der-03",
      "question": "Find the derivative of $f(x) = \\frac{x^3}{e^x}$.",
      "options": {
        "A": "$\\frac{3x^2}{e^x}$",
        "B": "$\\frac{x^2(3 - x)}{e^x}$",
        "C": "$\\frac{x^3 - 3x^2}{e^x}$",
        "D": "$\\frac{x^2(x - 3)}{e^x}$"
      },
      "correct_answer": "B",
      "explanation": "Use the quotient rule: $(u/v)' = \\frac{u'v - uv'}{v^2}$.\n\nLet $u = x^3$ and $v = e^x$.\n- $u' = 3x^2$\n- $v' = e^x$\n\n$$f'(x) = \\frac{3x^2 \\cdot e^x - x^3 \\cdot e^x}{(e^x)^2} = \\frac{e^x(3x^2 - x^3)}{e^{2x}} = \\frac{3x^2 - x^3}{e^x}$$\n\n$$= \\frac{x^2(3 - x)}{e^x}$$",
      "difficulty": "medium",
      "marks": 2,
      "negative_marks": -0.67,
      "tags": ["calculus", "derivatives", "quotient-rule"]
    },
    {
      "id": "der-04",
      "question": "Find $f'(\\pi/4)$ for $f(x) = \\tan(x)$.",
      "options": {
        "A": "$1$",
        "B": "$2$",
        "C": "$\\sqrt{2}$",
        "D": "$1/\\sqrt{2}$"
      },
      "correct_answer": "B",
      "explanation": "The derivative of $\\tan(x)$ is:\n$$f'(x) = \\sec^2(x) = \\frac{1}{\\cos^2(x)}$$\n\nAt $x = \\pi/4$:\n$$f'(\\pi/4) = \\sec^2(\\pi/4) = \\frac{1}{\\cos^2(\\pi/4)} = \\frac{1}{(1/\\sqrt{2})^2} = \\frac{1}{1/2} = 2$$",
      "difficulty": "medium",
      "marks": 2,
      "negative_marks": -0.67,
      "tags": ["calculus", "derivatives", "trigonometric"]
    },
    {
      "id": "der-05",
      "question": "If $f(x) = x^{1/3}$, find $f'(8)$.",
      "options": {
        "A": "$\\frac{1}{12}$",
        "B": "$\\frac{1}{6}$",
        "C": "$\\frac{1}{3}$",
        "D": "$\\frac{1}{4}$"
      },
      "correct_answer": "A",
      "explanation": "Use the power rule with $n = 1/3$:\n$$f'(x) = \\frac{1}{3} x^{1/3 - 1} = \\frac{1}{3} x^{-2/3} = \\frac{1}{3x^{2/3}}$$\n\nAt $x = 8$:\n$$f'(8) = \\frac{1}{3 \\cdot 8^{2/3}} = \\frac{1}{3 \\cdot (8^{1/3})^2} = \\frac{1}{3 \\cdot 2^2} = \\frac{1}{12}$$\n\nNote: $8^{1/3} = 2$ (cube root of 8).",
      "difficulty": "hard",
      "marks": 2,
      "negative_marks": -0.67,
      "tags": ["calculus", "derivatives", "fractional-exponent"]
    }
  ]
}
