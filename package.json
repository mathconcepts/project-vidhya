{
  "name": "project-vidhya",
  "version": "4.37.0",
  "description": "Project Vidhya — Cost-minimal local-first adaptive learning engine with a four-tier content cascade",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/mathconcepts/project-vidhya.git"
  },
  "homepage": "https://github.com/mathconcepts/project-vidhya",
  "bugs": {
    "url": "https://github.com/mathconcepts/project-vidhya/issues"
  },
  "scripts": {
    "build": "tsc",
    "build:frontend": "cd frontend && npm run build",
    "build:all": "npm run build:frontend",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "dev:server": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:content": "vitest run src/content/ src/verification/ --reporter=verbose",
    "test:content:watch": "vitest src/content/ src/verification/",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:interactives": "node scripts/lint-interactives.mjs",
    "lint:fork-test": "node scripts/fork-test-lint.mjs",
    "ci:content-gate": "tsx scripts/content-ci-gate.ts",
    "ci:pg-allowlist": "tsx scripts/check-pg-allowlist.ts",
    "ci:connection-budget": "tsx scripts/check-connection-budget.ts",
    "ci:seam-registry": "tsx scripts/check-seam-registry.ts",
    "ci:content-integrity": "tsx scripts/check-content-integrity.ts",
    "ci:intent-catalogue": "tsx scripts/check-intent-catalogue.ts",
    "ci:interactive-specs": "tsx scripts/lint-interactive-specs.ts",
    "ci:demo-rails": "tsx scripts/check-demo-rails.ts",
    "export:bundles": "tsx scripts/export-bundles.ts",
    "data:export": "tsx scripts/vidhya-data.ts export",
    "data:import": "tsx scripts/vidhya-data.ts import",
    "data:verify": "tsx scripts/vidhya-data.ts verify",
    "typecheck": "tsc --noEmit",
    "gen:intent-tables": "tsx scripts/generate-intent-tables.ts",
    "content:scrape": "tsx scripts/scrape-corpus.ts --source gate && tsx scripts/scrape-textbooks.ts --source openstax && tsx scripts/scrape-textbooks.ts --source ocw",
    "content:explainers": "tsx scripts/build-explainers.ts",
    "content:generate": "tsx src/jobs/job-cli.ts content-generation",
    "content:generate:auto": "bash scripts/run-content-generation.sh",
    "content:setup": "tsx src/jobs/setup-cli.ts",
    "variants:pending": "tsx scripts/generate-variants.ts --dry-run",
    "variants:generate": "tsx scripts/generate-variants.ts",
    "variants:eval": "tsx scripts/eval-judge.ts",
    "content:verify": "tsx src/jobs/job-cli.ts wolfram-verify",
    "content:verify:legacy": "tsx scripts/verify-wolfram-batch.ts",
    "content:bundle": "tsx scripts/build-bundle.ts",
    "content:refresh": "npm run content:scrape && npm run content:explainers && npm run content:verify && npm run content:bundle",
    "setup": "npm ci && cd frontend && npm ci && npm run build && cd .. && echo 'Run: npm run dev:server'",
    "postinstall": "node scripts/postinstall-check.cjs || true",
    "smoke:stdio": "VIDHYA_LOG_STDERR=off npx tsx smoke/stdio-integration-smoke.ts",
    "smoke:sdk-compat": "VIDHYA_LOG_STDERR=off npx tsx smoke/mcp-sdk-compatibility-smoke.ts",
    "smoke:live-llm": "npx tsx smoke/live-llm-smoke.ts",
    "smoke:all": "npm run smoke:stdio && npm run smoke:sdk-compat && npm run smoke:live-llm",
    "snapshot": "bash scripts/snapshot.sh",
    "snapshot:list": "bash scripts/snapshot-list.sh",
    "demo:setup": "npm ci && cd frontend && npm ci && cd .. && npm run demo:seed && echo '\\nDemo ready — run: npm run demo:start'",
    "demo:seed": "tsx demo/seed.ts",
    "demo:seed-media": "tsx demo/seed-media.ts",
    "demo:seed-history": "tsx demo/seed-history.ts",
    "demo:generate-audio": "tsx demo/generate-demo-audio.ts",
    "demo:reset": "tsx demo/reset.ts",
    "local": "bash scripts/local-install.sh",
    "demo:start": "bash demo/start.sh",
    "demo:verify": "tsx demo/verify.ts",
    "demo:scenario": "tsx scripts/run-scenario.ts",
    "demo:scenario:resume": "tsx scripts/run-scenario-resume.ts",
    "verify:teaching": "tsx scripts/verify-teaching-loop.ts",
    "verify:budget": "tsx scripts/verify-llm-budget.ts",
    "demo:log": "tsx demo/log.ts",
    "demo:channel-setup": "tsx demo/channel-setup.ts",
    "demo:channel-link": "tsx demo/channel-link.ts",
    "backup:create": "tsx scripts/backup-data.ts",
    "backup:list": "tsx scripts/backup-data.ts --list",
    "backup:prune": "tsx scripts/backup-data.ts --prune",
    "provision-tenant": "tsx scripts/provision-tenant.ts",
    "ci:syllabus-floor": "tsx scripts/check-syllabus-floor.ts",
    "ci:playbook-convention": "tsx scripts/check-playbook-convention.ts",
    "playbook:run": "tsx scripts/playbook-cli.ts run",
    "playbook:list": "tsx scripts/playbook-cli.ts list",
    "playbook:estimate": "tsx scripts/playbook-cli.ts estimate",
    "ci:template-coverage": "tsx scripts/check-template-coverage.ts",
    "ci:variant-agreement": "tsx scripts/check-variant-agreement.ts",
    "ci:practice-items": "tsx scripts/check-practice-items.ts",
    "ci:la-walkthrough": "tsx scripts/check-la-walkthrough.ts",
    "ci:gif-scenes": "tsx scripts/check-gif-scenes.ts",
    "ci:aggregate-drift": "tsx scripts/check-ci-aggregate-drift.ts",
    "ci": "npm run lint:fork-test && CONTENT_CI_STRICT=true npm run ci:content-gate && npm run ci:pg-allowlist && npm run ci:connection-budget && npm run ci:seam-registry && npm run ci:playbook-convention && npm run ci:content-integrity && npm run ci:interactive-specs && npm run ci:gif-scenes && npm run ci:template-coverage && npm run ci:variant-agreement && npm run ci:practice-items && npm run ci:demo-rails && npm run ci:syllabus-floor && npm run ci:la-walkthrough && npm run ci:intent-catalogue"
  },
  "keywords": [
    "adaptive-learning",
    "edtech",
    "content-engine",
    "rag",
    "local-first",
    "offline",
    "education",
    "gate",
    "wolfram",
    "multi-provider-llm"
  ],
  "author": "Project Vidhya Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@google/generative-ai": "^0.12.0",
    "@types/js-yaml": "^4.0.9",
    "gifenc": "^1.0.3",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "katex": "^0.16.44",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "resend": "^6.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^20.19.33",
    "@types/pg": "^8.18.0",
    "vitest": "^1.6.1"
  }
}
